    email = ChristianOudard@pm.me
    name = Christian Oudard
    signingkey = 4A2836BB6C6386BC61A27E4E21F7F2C0152F8B5F
[commit]
    gpgSign = true
[init]
    defaultBranch = main
[pull]
    ff = only
	rebase = true
[log]
	date = local
[protocol "file"]
	allow = always
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[advice]
	skippedCherryPicks = false
# Last, so it wins. For a machine that has no copy of the signing key above and
# signs with its own. Git ignores a path that does not exist, so every other
# machine needs no file here.
[include]
    path = config.local
