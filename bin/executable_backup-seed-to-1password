#!/bin/bash
set -euo pipefail

ITEM_NAME="Seed - bootstrap keys"

# Sign in unless this shell already has a live session.
op whoami >/dev/null 2>&1 || eval "$(op signin)"

# Stage in a private tmpfs directory, removed even if a step fails, so no
# plaintext copy outlives the run or lands in a backed-up directory.
TMP=$(mktemp -d -p "$XDG_RUNTIME_DIR")
trap 'rm -rf "$TMP"' EXIT
ARCHIVE="$TMP/seed.tar.xz"

# Export GPG keys
EMAIL=$(git config user.email) || { echo "Error: git config user.email is not set" >&2; exit 1; }
mkdir "$TMP/.gnupg"
gpg --export-secret-keys --output "$TMP/.gnupg/git-signing-key.gpg" "$EMAIL"

# Create tarball.
tar cJf "$ARCHIVE" \
    -C ~ .keys \
    -C ~ .ssh/christian_dedekind .ssh/google_compute_engine .ssh/config \
    -C "$TMP" .gnupg/git-signing-key.gpg

SIZE="$(stat --printf='%s' "$ARCHIVE" | numfmt --to=iec)"
echo "Created $ARCHIVE ($SIZE)"

# Upload to 1Password.
DOCUMENTS=$(op item list --categories Document --format=json)
if jq -e --arg t "$ITEM_NAME" 'any(.[]; .title == $t)' <<<"$DOCUMENTS" >/dev/null; then
    op document edit "$ITEM_NAME" "$ARCHIVE"
    echo "Updated '$ITEM_NAME' in 1Password"
else
    op document create "$ARCHIVE" --title "$ITEM_NAME"
    echo "Created '$ITEM_NAME' in 1Password"
fi
